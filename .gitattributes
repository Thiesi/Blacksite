# Content is hashed byte for byte (02-architecture.md section 6.2), so it
# must check out identically on every platform: LF line endings, and ANSI
# art untouched.
*.map   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.ans   binary
deploy/** text eol=lf
*.yml text eol=lf
# Local native evidence retains the exact Windows capture bytes and padding.
docs/ops/captures/s42/local-80x24-16/*.txt -text -whitespace
docs/ops/captures/s42/local-80x24-16/*.json -text -whitespace
docs/ops/captures/s42/validation/*.log -whitespace
docs/ops/captures/s42/native/*.txt -whitespace
