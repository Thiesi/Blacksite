[Unit]
Description=Karst 41 game service
After=network.target

[Service]
Type=simple
User=netbbs
Group=netbbs
WorkingDirectory=/var/db/karst41
ExecStart=/opt/karst41/venv/bin/python -m karst41.server --install-dir /var/db/karst41
# An admin stop may already have removed the socket when systemd runs this.
# Treat the RPC as best effort; systemd still sends TERM and waits below.
ExecStop=-/opt/karst41/venv/bin/python -m karst41.admin --install-dir /var/db/karst41 stop
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
