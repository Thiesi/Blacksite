[Unit]
Description=Blacksite game service
After=network.target

[Service]
Type=simple
User=netbbs
Group=netbbs
WorkingDirectory=/var/db/blacksite
ExecStart=/opt/blacksite/venv/bin/python -m blacksite.server --install-dir /var/db/blacksite
# An admin stop may already have removed the socket when systemd runs this.
# Treat the RPC as best effort; systemd still sends TERM and waits below.
ExecStop=-/opt/blacksite/venv/bin/python -m blacksite.admin --install-dir /var/db/blacksite stop
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
