#!/bin/sh
# PROVIDE: karst41
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr
name="karst41"
rcvar="karst41"
load_rc_config "$name"
: ${karst41:=NO}
: ${karst41_user:=netbbs}
: ${karst41_dir:=/var/db/karst41}
: ${karst41_python:=/opt/karst41/venv/bin/python}
: ${karst41_flags:=}
command="$karst41_python"
# This is a binary, not a shebang script. Backgrounding is explicit.
command_interpreter=""
command_args="-m karst41.server --install-dir '$karst41_dir'"
pidfile="$karst41_dir/run/karst41.pid"
start_cmd="karst41_start"
stop_cmd="karst41_stop"

karst41_as_user()
{
    if [ "$(id -un)" = "$karst41_user" ]; then
        /bin/sh -c "$1"
    else
        su -m "$karst41_user" -c "$1"
    fi
}

karst41_start()
{
    if [ ! -x "$command" ]; then
        echo "karst41: interpreter is not executable: $command" >&2
        return 1
    fi
    if [ "$karst41_user" = root ] || [ "$(id -u "$karst41_user")" = 0 ]; then
        echo "karst41: choose a non-root service account" >&2
        return 1
    fi
    if [ -n "$(check_pidfile "$pidfile" "$command")" ]; then
        echo "karst41: already running" >&2
        return 1
    fi
    # rc_flags must follow -m and the module, not the interpreter.
    karst41_as_user "mkdir -p '$karst41_dir/logs' && exec '$command' $command_args $rc_flags </dev/null >>'$karst41_dir/logs/service.log' 2>&1" &
    count=0
    while [ "$count" -lt 10 ]; do
        [ -n "$(check_pidfile "$pidfile" "$command")" ] && return 0
        sleep 1
        count=$((count + 1))
    done
    echo "karst41: startup failed; inspect $karst41_dir/logs/service.log" >&2
    return 1
}

karst41_stop()
{
    service_pid=$(check_pidfile "$pidfile" "$command")
    [ -n "$service_pid" ] || return 1
    karst41_as_user "exec '$command' -m karst41.admin --install-dir '$karst41_dir' stop" || :
    count=0
    while [ "$count" -lt 10 ]; do
        [ "$(check_pidfile "$pidfile" "$command")" = "$service_pid" ] || return 0
        sleep 1
        count=$((count + 1))
    done
    if [ "$(check_pidfile "$pidfile" "$command")" = "$service_pid" ]; then
        kill -TERM "$service_pid" || return 1
    fi
    count=0
    while [ "$count" -lt 10 ]; do
        [ "$(check_pidfile "$pidfile" "$command")" = "$service_pid" ] || return 0
        sleep 1
        count=$((count + 1))
    done
    echo "karst41: service did not stop" >&2
    return 1
}

run_rc_command "$1"
