  "places": [
    {
      "name": "Under the halo",
      "rect": [
        1,
        1,
        5,
        5
      ],
      "at": [
        3,
        3
      ],
      "text": "You stand under a halo of tin cans a drunk welded up forty years ago. Nobody has taken it down.",
      "view": {
        "at": [
          3,
          8
        ],
        "facing": "up"
      }
    },
    {
