        13,
        19,
        4
      ],
      "at": [
        12,
        14
      ],
      "text": "A counter the length of the room. Vesper sits at its end with three screens and a drink that does not get lower.",
      "view": {
        "at": [
          11,
          9
        ],
        "facing": "down"
      }
    },
    {
