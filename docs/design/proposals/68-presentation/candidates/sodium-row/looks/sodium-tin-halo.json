        4
      ],
      "at": [
        34,
        14
      ],
      "text": "A table at the quiet end of the bar. The Ferrymen liaison is sometimes in.",
      "view": {
        "at": [
          36,
          10
        ],
        "facing": "down"
      }
    },
    {
